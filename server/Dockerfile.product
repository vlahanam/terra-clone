# Stage 1: Build production binary
FROM golang:1.26-alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,direct

RUN apk add --no-cache git ca-certificates tzdata

# Install golang-migrate CLI with postgres support
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.17.0

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Build stripped and trimmed production binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -trimpath -o /app/bin/server ./cmd/main.go

# Stage 2: Minimal hardened runtime image
FROM alpine:3.24

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 appgroup && \
    adduser -S -D -H -u 10001 -G appgroup appuser

COPY --from=builder --chown=10001:10001 /app/bin/server /app/server
COPY --from=builder --chown=10001:10001 /go/bin/migrate /usr/local/bin/migrate
COPY --from=builder --chown=10001:10001 /app/migrations /app/migrations

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["/app/server"]

