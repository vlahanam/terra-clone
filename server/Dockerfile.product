# Stage 1: Build production binary
FROM golang:1.26.7-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Build stripped and trimmed production binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -trimpath -o /app/bin/server ./cmd/main.go

# Stage 2: Minimal hardened runtime image
FROM alpine:3.21

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 appgroup && \
    adduser -S -D -H -u 10001 -G appgroup appuser

COPY --from=builder --chown=10001:10001 /app/bin/server /app/server

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["/app/server"]

