# [VN] Giai đoạn 1: Biên dịch mã nguồn ứng dụng Golang
FROM golang:1.26-alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,direct

RUN apk add --no-cache git ca-certificates tzdata

# [VN] Cài đặt công cụ migration CLI
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.17.0

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/server ./cmd/main.go

# [VN] Giai đoạn 2: Runtime image tối giản cho Staging
FROM alpine:3.24

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata curl && \
    addgroup -S -g 1001 appgroup && \
    adduser -S -u 1001 -G appgroup appuser

COPY --from=builder --chown=1001:1001 /app/bin/server /app/server
COPY --from=builder --chown=1001:1001 /go/bin/migrate /usr/local/bin/migrate
COPY --from=builder --chown=1001:1001 /app/migrations /app/migrations

USER 1001:1001

EXPOSE 8080

ENTRYPOINT ["/app/server"]

